{
  "name": "bakers_comment_create",
  "inputSchema": {
    "type": "object",
    "properties": {
      "ticket": {
        "type": "string",
        "minLength": 1,
        "description": "Ticket identifier (e.g. BAKERS-15) or UUID.",
        "title": "Ticket"
      },
      "type": {
        "type": "string",
        "maxLength": 64,
        "minLength": 1,
        "description": "The bb_comment_type, e.g. comment, plan, spec, test, acceptance, summary, qualification.",
        "title": "Comment type"
      },
      "body": {
        "type": "string",
        "pattern": "\\S",
        "contentMediaType": "text/markdown",
        "minLength": 1,
        "description": "Markdown source; raw HTML is stripped.",
        "title": "Body"
      }
    },
    "required": [
      "ticket",
      "type",
      "body"
    ],
    "additionalProperties": false
  }
}
