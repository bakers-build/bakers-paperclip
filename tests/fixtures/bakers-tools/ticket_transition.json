{
  "name": "bakers_ticket_transition",
  "inputSchema": {
    "type": "object",
    "properties": {
      "ticket": {
        "type": "string",
        "minLength": 1,
        "description": "Ticket identifier (e.g. BAKERS-15) or UUID.",
        "title": "Ticket"
      },
      "state": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "description": "The workflow state id to move to, e.g. working or review; omit to only append links.",
        "title": "Target state"
      },
      "links": {
        "type": [
          "array",
          "null"
        ],
        "description": "Links to add; existing links are kept and duplicates merged.",
        "items": {
          "type": "object",
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1,
              "description": "The link target, e.g. a merge request URL.",
              "title": "URI"
            },
            "title": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The link text.",
              "title": "Title"
            }
          },
          "required": [
            "uri"
          ],
          "description": "One link.",
          "title": "Link"
        },
        "title": "Links"
      }
    },
    "required": [
      "ticket"
    ],
    "additionalProperties": false
  }
}
