# Copy to .env (gitignored) and fill in. README › Configuration says where each value comes from.

# Paperclip
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_PORT=3100
PAPERCLIP_ALLOWED_HOSTNAMES=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
PM_CLONES_DIR=./data/clones

# Local bakers.build (docker compose --profile bakers up)
BAKERS_DB_PASSWORD=
BAKERS_DB_ROOT_PASSWORD=
BAKERS_HASH_SALT=
BAKERS_ADMIN_EMAIL=admin@bakers.localhost

# Local demo (docker compose --profile demo up)
DEMO_BAKERS_API_KEY=
BAKERS_WEBHOOK_SECRET=
DEMO_PORT=8090
DEMO_STEP_MS=2000
